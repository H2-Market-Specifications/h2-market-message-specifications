{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-market.example/message-specifications/schemas/messages/balancinggrouplist/v0.9/balancinggrouplist-message-base.schema.json",
  "title": "h2BalancingGroupListMessage",
  "description": "Base schema for transmitting the list of valid balancing groups from the Hydrogen Market Area Manager to a Hydrogen Grid Operator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "parties",
    "balancingGroupList"
  ],
  "properties": {
    "message": {
      "allOf": [
        {
          "$ref": "https://h2-market.example/message-specifications/schemas/_shared/v0.9/message.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "BALANCINGGROUPLIST"
            },
            "version": {
              "const": "0.9"
            }
          }
        }
      ]
    },
    "parties": {
      "allOf": [
        {
          "$ref": "https://h2-market.example/message-specifications/schemas/_shared/v0.9/parties.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "sender": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "const": "HydrogenMarketAreaManager"
                }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "const": "HydrogenGridOperator"
                }
              }
            }
          }
        }
      ]
    },
    "balancingGroupList": {
      "type": "array",
      "minItems": 1,
      "description": "List of balancing group entries.",
      "items": {
        "$ref": "https://h2-market.example/message-specifications/schemas/messages/balancinggrouplist/v0.9/components/balancinggrouplist-entry.schema.json"
      }
    }
  }
}
