{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-market.example/message-specifications/schemas/messages/nomination/v0.9/nomination-message-base.schema.json",
  "title": "h2NominationMessage",
  "description": "Base schema for transmitting nomination time series from a Balancing Group Responsible Party or the Hydrogen Market Area Manager to the responsible Hydrogen Grid Operator or Hydrogen Market Area Manager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "parties",
    "nominationData"
  ],
  "properties": {
    "message": {
      "allOf": [
        {
          "$ref": "https://h2-market.example/message-specifications/schemas/_shared/v0.9/message.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "NOMINATION"
            },
            "version": {
              "const": "0.9"
            }
          }
        }
      ]
    },
    "parties": {
      "allOf": [
        {
          "$ref": "https://h2-market.example/message-specifications/schemas/_shared/v0.9/parties.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "sender": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "enum": [
                    "BalancingGroupResponsibleParty",
                    "HydrogenMarketAreaManager"
                  ]
                }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "enum": [
                    "HydrogenGridOperator",
                    "HydrogenMarketAreaManager"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "nominationData": {
      "$ref": "https://h2-market.example/message-specifications/schemas/messages/nomination/v0.9/components/nomination-data.schema.json"
    }
  }
}
