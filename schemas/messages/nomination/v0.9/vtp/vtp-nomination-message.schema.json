{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-market.example/message-specifications/schemas/messages/nomination/v0.9/vtp/vtp-nomination-message.schema.json",
  "title": "h2VtpNominationMessage",
  "description": "Message for transmitting nominations for the transfer of hydrogen quantities between balancing groups at the Virtual Trading Point.",
  "allOf": [
    {
      "$ref": "../nomination-message-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "type": "object",
          "properties": {
            "subType": {
              "const": "VTP"
            }
          }
        },
        "parties": {
          "type": "object",
          "properties": {
            "sender": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "enum": [
                    "BalancingGroupResponsibleParty",
                    "HydrogenMarketAreaManager"
                  ]
                }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "const": "HydrogenMarketAreaManager"
                }
              }
            }
          }
        },
        "nominationData": {
          "type": "object",
          "properties": {
            "location": {
              "type": "object",
              "properties": {
                "locationType": {
                  "const": "VirtualTradingPoint"
                },
                "locationCode": {
                  "const": "VTP-H2"
                }
              }
            }
          }
        }
      }
    }
  ]
}
