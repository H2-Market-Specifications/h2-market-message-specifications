{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-market.example/message-specifications/schemas/messages/balancing/v0.9/differencequantities/differencequantities-balancing-message.schema.json",
  "title": "h2DifferenceQuantitiesBalancingMessage",
  "description": "Message for transmitting balancing quantities related to the post-monthly balancing mechanism, including closed balances, final balances and balance differences.",
  "allOf": [
    {
      "$ref": "../balancing-message-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "type": "object",
          "properties": {
            "subType": {
              "const": "DifferenceQuantities"
            }
          }
        },
        "balancingData": {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "description": "Unit of the balancing quantities."
            },
            "balancingFigures": {
              "type": "array",
              "minItems": 1,
              "description": "Balancing quantity time series related to the post-monthly balancing mechanism.",
              "items": {
                "$ref": "../components/balancing-number.schema.json"
              }
            }
          }
        }
      }
    }
  ]
}
