{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-market.example/message-specifications/schemas/messages/nominationresponse/v0.9/physical/physical-nominationresponse-message.schema.json",
  "title": "h2PhysicalNominationResponseMessage",
  "description": "Message for transmitting the processed and confirmed result of a physical nomination from the responsible Hydrogen Grid Operator to the Balancing Group Responsible Party.",
  "allOf": [
    {
      "$ref": "../nomination-response-message-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "type": "object",
          "properties": {
            "subType": {
              "const": "Physical"
            }
          }
        },
        "parties": {
          "type": "object",
          "properties": {
            "sender": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "const": "HydrogenGridOperator"
                }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "partnerRole": {
                  "const": "BalancingGroupResponsibleParty"
                }
              }
            }
          }
        }
      }
    }
  ]
}
